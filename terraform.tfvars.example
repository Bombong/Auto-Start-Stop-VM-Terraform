# Copy file ini menjadi terraform.tfvars, isi sesuai client, lalu jalankan:
#   terraform init
#   terraform plan
#   terraform apply

tenant_id       = "00000000-0000-0000-0000-000000000000"
subscription_id = "11111111-1111-1111-1111-111111111111"

client_name          = "ClientA"
resource_group_name  = "RG-Automation"
location             = "southeastasia"

role_scope_level = "subscription"   # atau "resource_group"
# vm_resource_groups = ["RG-AD", "RG-APP"]  # isi hanya jika role_scope_level = "resource_group"

tenant_display_name = "PT Client A Indonesia"

teams_webhook_url = "https://default....environment.api.powerplatform.com/.../invoke?...sig=..."

included_vms = ["VM*", "APP-*"]

# Jadwal tidak perlu diisi — otomatis H+1 08:30 & 22:30 WIB dari saat terraform apply dijalankan.
