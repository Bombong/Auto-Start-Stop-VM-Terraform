# Terraform state — berisi data sensitif, jangan pernah di-commit
*.tfstate
*.tfstate.*
*.tfstate.backup

# Terraform variables — berisi credential dan data client
terraform.tfvars

# Terraform working directory
.terraform/
.terraform.lock.hcl

# Crash log
crash.log
crash.*.log

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json
